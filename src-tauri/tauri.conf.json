{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE Wishlist Overlay",
  "version": "1.0.1",
  "identifier": "com.xddgaming.wishlist-overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Wishlist Overlay",
        "width": 360,
        "height": 280,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "PoE Wishlist Overlay — Setup",
        "width": 460,
        "height": 540,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "Wishlist Notifications",
        "width": 340,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBOTNEOTE5NjdFMjNEMzIKUldReVBlSm5HZG1UdWtxZ1gyZSt0OE5INndRZjdYWi9aa1VRSTRvd01VYWRWNnhpZkxCSmZXZlkK",
      "endpoints": [
        "https://github.com/Snazethebaze/xddGaming-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
